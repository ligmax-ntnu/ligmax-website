---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide {
  image: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  slides: Slide[];
  /** CSS aspect-ratio for the frame — pick one that suits the slides so letterboxing stays small. */
  ratio?: string;
}

const { slides, ratio = '4 / 3' } = Astro.props;
---

<figure class="carousel" data-carousel style={`--carousel-ratio: ${ratio}`}>
  <div class="carousel-frame">
    {slides.map((slide, index) => (
      <Image
        class="carousel-image"
        src={slide.image}
        alt={slide.alt}
        widths={[480, 720, 1080]}
        sizes="(max-width: 900px) 92vw, 520px"
        loading={index === 0 ? 'eager' : 'lazy'}
        hidden={index !== 0}
      />
    ))}

    <button class="carousel-btn carousel-btn--prev" type="button" aria-label="Previous image">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 5l-7 7 7 7" />
      </svg>
    </button>
    <button class="carousel-btn carousel-btn--next" type="button" aria-label="Next image">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>

  <figcaption class="carousel-caption" aria-live="polite">
    {slides.map((slide, index) => (
      <span class="carousel-text" hidden={index !== 0}>{slide.caption}</span>
    ))}
    <span class="carousel-count"><span data-current>1</span> / {slides.length}</span>
  </figcaption>
</figure>

<script>
  // One handler set per carousel on the page; slides are plain hidden/shown
  // elements, so without JS the first slide still renders as a normal figure.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const images = Array.from(root.querySelectorAll<HTMLElement>('.carousel-image'));
    const texts = Array.from(root.querySelectorAll<HTMLElement>('.carousel-text'));
    const counter = root.querySelector<HTMLElement>('[data-current]');
    if (images.length < 2) return;

    let index = 0;

    const show = (next: number) => {
      index = (next + images.length) % images.length;
      images.forEach((el, i) => (el.hidden = i !== index));
      texts.forEach((el, i) => (el.hidden = i !== index));
      if (counter) counter.textContent = String(index + 1);
    };

    root.querySelector('.carousel-btn--next')?.addEventListener('click', () => show(index + 1));
    root.querySelector('.carousel-btn--prev')?.addEventListener('click', () => show(index - 1));

    root.addEventListener('keydown', (event) => {
      if (event instanceof KeyboardEvent && event.key === 'ArrowRight') show(index + 1);
      if (event instanceof KeyboardEvent && event.key === 'ArrowLeft') show(index - 1);
    });
  });
</script>

<style>
  .carousel {
    margin: 0;
  }

  .carousel-frame {
    position: relative;
    aspect-ratio: var(--carousel-ratio);
  }

  .carousel-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* global.css sets `img { display: block }`, which outranks the [hidden]
     attribute — without this every slide would stack on the first. */
  .carousel-image[hidden],
  .carousel-text[hidden] {
    display: none;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    background: rgba(9, 17, 33, 0.62);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .carousel-btn svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .carousel-btn:hover {
    background: rgba(9, 17, 33, 0.85);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .carousel-btn:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
  }

  .carousel-btn--prev {
    left: 0.7rem;
  }

  .carousel-btn--next {
    right: 0.7rem;
  }

  .carousel-caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    text-align: left;
    font-size: 0.82rem;
    line-height: 1.55;
    padding: 0.75rem 1rem 0.9rem;
    /* The host panel sets this when it sits on a dark background. */
    color: var(--carousel-caption-color, var(--muted));
  }

  .carousel-count {
    flex: none;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-btn {
      transition: none;
    }
  }
</style>
