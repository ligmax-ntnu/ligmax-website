---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Every value on this page is read from the source in the ligmax-ntnu repos or from
// the 2026 technical report. Keep it in sync with ligmax-main/docs/fleet.json.
const ports = [
  { port: '443', transport: 'TCP / HTTPS', service: 'Operator dashboard, via reverse proxy', host: 'Ground station', scope: 'Internet — live.ligmax.no' },
  { port: '3338', transport: 'TCP / HTTP', service: 'Dashboard app behind the proxy', host: 'Ground station', scope: 'localhost only' },
  { port: '3338', transport: 'TCP', service: 'Jetson frame ingest', host: 'Viewer host', scope: 'Vessel LAN' },
  { port: '8771', transport: 'UDP', service: 'Telemetry ingest from the vessel', host: 'Ground station', scope: 'Vessel LAN / 5G' },
  { port: '8080', transport: 'HTTP', service: 'MJPEG camera view', host: 'Viewer host', scope: 'Vessel LAN' },
  { port: '5555–5560', transport: 'TCP (ZeroMQ)', service: 'Companion-computer node bus', host: 'Raspberry Pi 5', scope: 'localhost only' },
  { port: '2101', transport: 'TCP (NTRIP)', service: 'RTK corrections — planned', host: 'Ground station', scope: 'Internet — rtk.ligmax.no' },
];

const buses = [
  { bus: 'CAN', id: 'can1 @ 250 kbit/s', between: 'Pi 5 ↔ Daly 150 A BMS', carries: 'Pack voltage, current, SoC, per-cell mV, temperatures, alarms' },
  { bus: 'CAN', id: 'vehicle bus', between: 'Pixhawk ↔ VESC 6.7 ×2', carries: 'Field-oriented motor commands' },
  { bus: 'MAVLink', id: '/dev/ttyACM0 @ 115200', between: 'Pi 5 ↔ Pixhawk 6C', carries: 'Setpoints, RC override ch 6, telemetry, heartbeat' },
  { bus: 'PWM', id: '1000–2000 µs', between: 'Pixhawk → both ESP32s, stern ESC', carries: 'Actuator and thruster demand' },
  { bus: 'CSI', id: '/dev/video0-1', between: 'Cameras → Jetson', carries: '2592×1944@14, 1920×1080@29 or 1296×972@28' },
];

const sliderPins = [
  { pin: '34', dir: 'in', signal: 'PIXHAWK_PWM_PIN', to: 'Pixhawk PWM out — rail position demand' },
  { pin: '35', dir: 'in', signal: 'RPI_HOMING_PIN', to: 'Raspberry Pi, 3.3 V homing trigger' },
  { pin: '25', dir: 'out', signal: 'PUL_PIN', to: 'DM542C PUL+ (step)' },
  { pin: '26', dir: 'out', signal: 'DIR_PIN', to: 'DM542C DIR+' },
  { pin: '27', dir: 'out', signal: 'ENA_PIN', to: 'DM542C ENA+' },
  { pin: '12', dir: 'in', signal: 'LIMIT_REAR_PIN', to: 'Rear endstop → GND (pull-up)' },
  { pin: '14', dir: 'in', signal: 'LIMIT_FRONT_PIN', to: 'Front endstop → GND (pull-up)' },
  { pin: '13', dir: 'in', signal: 'LIMIT_MID_OPTO_PIN', to: 'Optical centre endstop → GND (pull-up)' },
];

const translatorPins = [
  { pin: '34', dir: 'in', signal: 'RC_CH1_PIN', to: 'Pixhawk out 1 — left actuator demand' },
  { pin: '35', dir: 'in', signal: 'RC_CH2_PIN', to: 'Pixhawk out 2 — right actuator demand' },
  { pin: '25', dir: 'out', signal: 'MOTOR_A_IN1', to: '160 W driver IN1' },
  { pin: '26', dir: 'out', signal: 'MOTOR_A_IN2', to: '160 W driver IN2' },
  { pin: '27', dir: 'out', signal: 'MOTOR_A_ENA', to: '160 W driver ENA (PWM 0–255)' },
  { pin: '12', dir: 'out', signal: 'MOTOR_B_IN3', to: '160 W driver IN3' },
  { pin: '14', dir: 'out', signal: 'MOTOR_B_IN4', to: '160 W driver IN4' },
  { pin: '13', dir: 'out', signal: 'MOTOR_B_ENB', to: '160 W driver ENB (PWM 0–255)' },
];
---

<BaseLayout
  title="Systems — Ligmax | Communications, power and GPIO"
  description="How Ligmax is wired: the full communications map with every port, the power architecture from the 12S12P pack to the thrusters, and the GPIO pin maps for both ESP32 subsystem boards."
>
  <Header />
  <main id="main">
    <section class="page-intro">
      <div class="container">
        <span class="intro-eyebrow">Systems &middot; Reference</span>
        <h1>How it all connects</h1>
        <p>
          Ligmax is five computers, two microcontrollers and one flight controller talking over
          six different transports. These are the working diagrams the team builds against: what
          talks to what, which port it uses, where the power goes, and which GPIO pin does what
          on each ESP32.
        </p>
      </div>
    </section>

    <!-- ── Communications ──────────────────────────────────────────────── -->
    <section class="section">
      <div class="container">
        <span class="eyebrow">Communications</span>
        <h2 class="section-title">Every link, and the port it runs on</h2>
        <p class="section-lead">
          The Raspberry Pi 5 is the hub. Perception runs beside it on the Jetson, hard real-time
          control runs below it on the Pixhawk, and everything reaching shore goes out through the
          5G router — except the RC link, which is deliberately independent of all of it.
        </p>

        <figure class="diagram" data-reveal>
          <svg
            viewBox="0 0 980 660"
            role="img"
            aria-label="Communications map. On shore: an operator browser connects to the ligmax-server dashboard over HTTPS port 443, and an edge viewer receives Jetson frames on TCP port 3338 and serves MJPEG on port 8080. Crossing to the vessel: the 5G router and vessel LAN carry telemetry on UDP 8771 and camera frames on TCP 3338, while an independent FRSky RC receiver carries manual control. On the vessel: the Jetson Orin Nano takes two CSI cameras, the Raspberry Pi 5 links to the Pixhawk 6C over MAVLink on slash dev slash ttyACM0 at 115200 baud and to the Daly BMS over CAN can1 at 250 kilobit per second, and the Pixhawk drives two ESP32 boards over PWM and two VESC controllers over CAN."
          >
            <defs>
              <marker id="ar-net" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0,1 L9,5 L0,9 z" class="fill-net" />
              </marker>
              <marker id="ar-radio" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0,1 L9,5 L0,9 z" class="fill-radio" />
              </marker>
              <marker id="ar-wire" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0,1 L9,5 L0,9 z" class="fill-wire" />
              </marker>
            </defs>

            <!-- zones -->
            <text x="20" y="24" class="zone">SHORE</text>
            <line x1="0" y1="140" x2="940" y2="140" class="divider" />
            <text x="20" y="164" class="zone">VESSEL</text>

            <!-- shore row -->
            <rect x="24" y="36" width="216" height="60" rx="8" class="box" />
            <text x="132" y="61" class="t-title">Operator browser</text>
            <text x="132" y="80" class="t-sub">live.ligmax.no</text>

            <rect x="300" y="36" width="256" height="60" rx="8" class="box box-accent" />
            <text x="428" y="61" class="t-title">ligmax-server</text>
            <text x="428" y="80" class="t-sub">dashboard + telemetry ingest, behind TLS</text>

            <rect x="672" y="36" width="244" height="60" rx="8" class="box" />
            <text x="794" y="61" class="t-title">Edge viewer</text>
            <text x="794" y="80" class="t-sub">receiver.py — draws boxes, serves MJPEG</text>

            <!-- browser <-> dashboard -->
            <line x1="240" y1="66" x2="296" y2="66" class="net" marker-end="url(#ar-net)" marker-start="url(#ar-net)" />
            <text x="268" y="30" class="t-port">HTTPS 443</text>

            <!-- link layer -->
            <rect x="300" y="196" width="256" height="56" rx="8" class="box" />
            <text x="428" y="219" class="t-title">5G router · vessel LAN</text>
            <text x="428" y="238" class="t-sub">UDP hole-punched direct link</text>

            <rect x="672" y="196" width="244" height="56" rx="8" class="box box-radio" />
            <text x="794" y="219" class="t-title">FRSky RC receiver</text>
            <text x="794" y="238" class="t-sub">manual + kill/hold fallback</text>

            <!-- dashboard <- router : telemetry -->
            <line x1="428" y1="196" x2="428" y2="100" class="net" marker-end="url(#ar-net)" />
            <text x="436" y="132" class="t-port a-start">UDP 8771 telemetry</text>

            <!-- viewer <- router : frames -->
            <path d="M540 196 L540 168 L794 168 L794 100" class="net" marker-end="url(#ar-net)" />
            <text x="700" y="160" class="t-port">TCP 3338 frames</text>

            <!-- RC down to Pixhawk -->
            <line x1="794" y1="252" x2="794" y2="330" class="radio" marker-end="url(#ar-radio)" />
            <text x="802" y="296" class="t-port a-start">RC</text>

            <!-- vessel computers -->
            <rect x="24" y="330" width="216" height="66" rx="8" class="box" />
            <text x="132" y="356" class="t-title">Jetson Orin Nano</text>
            <text x="132" y="375" class="t-sub">TensorRT detector + classifier</text>

            <rect x="300" y="330" width="256" height="66" rx="8" class="box box-accent" />
            <text x="428" y="356" class="t-title">Raspberry Pi 5</text>
            <text x="428" y="375" class="t-sub">planner · world model · uplink</text>

            <rect x="672" y="330" width="244" height="66" rx="8" class="box" />
            <text x="794" y="356" class="t-title">Pixhawk 6C</text>
            <text x="794" y="375" class="t-sub">PID · thrust mixing · failsafes</text>

            <!-- Pi -> router -->
            <line x1="428" y1="330" x2="428" y2="256" class="net" marker-end="url(#ar-net)" />
            <!-- Jetson -> router (lands on the router's bottom edge, not beside it) -->
            <path d="M132 330 L132 288 L340 288 L340 256" class="net" marker-end="url(#ar-net)" />

            <!-- Pi <-> Pixhawk : MAVLink -->
            <line x1="556" y1="363" x2="668" y2="363" class="wire" marker-end="url(#ar-wire)" marker-start="url(#ar-wire)" />
            <text x="612" y="352" class="t-bus">MAVLink</text>
            <text x="612" y="389" class="t-bus">115200</text>

            <!-- peripherals -->
            <rect x="24" y="486" width="216" height="52" rx="8" class="box box-soft" />
            <text x="132" y="508" class="t-title">2× OV5647 fisheye</text>
            <text x="132" y="526" class="t-sub">220° lenses, ±15° aim</text>

            <rect x="300" y="486" width="256" height="52" rx="8" class="box box-soft" />
            <text x="428" y="508" class="t-title">Lidar ×2 · sonar</text>
            <text x="428" y="526" class="t-sub">RPLIDAR front (gimballed) + rear</text>

            <rect x="300" y="566" width="256" height="52" rx="8" class="box box-soft" />
            <text x="428" y="588" class="t-title">Daly 150 A BMS</text>
            <text x="428" y="606" class="t-sub">12 cells, SoC, temps, alarms</text>

            <rect x="672" y="486" width="244" height="52" rx="8" class="box box-soft" />
            <text x="794" y="508" class="t-title">Translator + Slider ESP32</text>
            <text x="794" y="526" class="t-sub">roll actuators · battery rail</text>

            <rect x="672" y="566" width="244" height="52" rx="8" class="box box-soft" />
            <text x="794" y="588" class="t-title">VESC 6.7 ×2 · stern ESC</text>
            <text x="794" y="606" class="t-sub">Flipsky 5085 ×2 + F2838</text>

            <!-- cameras -> Jetson -->
            <line x1="132" y1="486" x2="132" y2="400" class="wire" marker-end="url(#ar-wire)" />
            <text x="140" y="446" class="t-bus a-start">CSI</text>

            <!-- lidar -> Pi -->
            <line x1="380" y1="486" x2="380" y2="400" class="wire" marker-end="url(#ar-wire)" />
            <text x="388" y="446" class="t-bus a-start">USB</text>

            <!-- BMS -> Pi : CAN -->
            <path d="M300 592 L268 592 L268 363 L296 363" class="can" marker-end="url(#ar-wire)" />
            <text x="262" y="470" class="t-bus a-end">CAN 250k</text>

            <!-- Pixhawk -> ESP32s : PWM -->
            <line x1="740" y1="400" x2="740" y2="482" class="pwm" marker-end="url(#ar-wire)" />
            <text x="732" y="446" class="t-bus a-end">PWM</text>

            <!-- Pixhawk -> VESC : CAN. Routed out to the right corridor so it does not
                 cross the ESP32 box that sits between the two. -->
            <path d="M916 380 L948 380 L948 592 L920 592" class="can" marker-end="url(#ar-wire)" />
            <text x="956" y="470" class="t-bus a-start">CAN</text>

            <!-- legend -->
            <g class="legend">
              <line x1="24" y1="636" x2="60" y2="636" class="net" />
              <text x="68" y="640" class="t-legend">IP link with a port</text>
              <line x1="200" y1="636" x2="236" y2="636" class="radio" />
              <text x="244" y="640" class="t-legend">Independent radio</text>
              <line x1="380" y1="636" x2="416" y2="636" class="wire" />
              <text x="424" y="640" class="t-legend">Serial / USB / CSI</text>
              <line x1="556" y1="636" x2="592" y2="636" class="can" />
              <text x="600" y="640" class="t-legend">CAN bus</text>
              <line x1="688" y1="636" x2="724" y2="636" class="pwm" />
              <text x="732" y="640" class="t-legend">Servo PWM</text>
            </g>
          </svg>
          <figcaption>
            Everything that leaves the vessel is coloured and carries a port number — those are the
            links a firewall sees. The FRSky RC path is drawn separately because it shares no
            hardware with the 5G link: if the network drops, it still flies.
          </figcaption>
        </figure>

        <h3 class="sub-title">Listening ports</h3>
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr><th>Port</th><th>Transport</th><th>Service</th><th>Host</th><th>Reachable from</th></tr>
            </thead>
            <tbody>
              {ports.map((p) => (
                <tr>
                  <td class="mono">{p.port}</td>
                  <td>{p.transport}</td>
                  <td>{p.service}</td>
                  <td>{p.host}</td>
                  <td>{p.scope}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">
The dashboard is served over HTTPS on 443 by a reverse proxy in front of the app, which
          itself listens only on localhost. Note that 3338 is also the default for the Jetson
          frame feed, so those two must not share a host without moving one of them.
        </p>

        <h3 class="sub-title">On-board buses</h3>
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr><th>Bus</th><th>Identifier</th><th>Between</th><th>Carries</th></tr>
            </thead>
            <tbody>
              {buses.map((b) => (
                <tr>
                  <td>{b.bus}</td>
                  <td class="mono">{b.id}</td>
                  <td>{b.between}</td>
                  <td>{b.carries}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ── Power ───────────────────────────────────────────────────────── -->
    <section class="section section--soft">
      <div class="container">
        <span class="eyebrow">Power</span>
        <h2 class="section-title">From 144 cells to five kilowatts</h2>
        <p class="section-lead">
          One pack feeds everything, split immediately into a high-voltage path for propulsion and
          a low-voltage path for compute. Two things must both be closed before any propulsion
          power flows, and one circuit deliberately bypasses the whole system.
        </p>

        <figure class="diagram" data-reveal>
          <svg
            viewBox="0 0 940 566"
            role="img"
            aria-label="Power architecture. A 12S12P pack of 144 Samsung INR18650-35E cells at 44.4 volts nominal and 1.8 kilowatt-hours feeds a Daly 150 amp BMS, which reports telemetry over CAN to the Raspberry Pi. The pack also feeds an emergency-stop safety loop in which a physical button and a compute-driven relay sit in series; both must be closed for the main contactor to close and pass power to the high-voltage DC-DC converter, which drives two VESC 6.7 controllers and a 30 amp stern ESC. A separate low-voltage DC-DC converter feeds the Pi 5, Jetson, Pixhawk, both ESP32s, the motor drivers, sensors and the 5G router. An independent 9 volt circuit can open the locking lid even when the main system is down."
          >
            <defs>
              <marker id="ar-hv" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0,1 L9,5 L0,9 z" class="fill-hv" />
              </marker>
              <marker id="ar-lv" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0,1 L9,5 L0,9 z" class="fill-lv" />
              </marker>
              <marker id="ar-sig" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0,1 L9,5 L0,9 z" class="fill-wire" />
              </marker>
            </defs>

            <!-- pack -->
            <rect x="20" y="150" width="200" height="112" rx="8" class="box box-accent" />
            <text x="120" y="178" class="t-title">Battery pack</text>
            <text x="120" y="199" class="t-sub">12S12P · 144× INR18650-35E</text>
            <text x="120" y="218" class="t-sub">≈44.4 V nominal · ≈1.8 kWh</text>
            <text x="120" y="243" class="t-sub t-em">Firebox · structure · trim mass</text>

            <!-- BMS -->
            <rect x="278" y="40" width="186" height="66" rx="8" class="box" />
            <text x="371" y="66" class="t-title">Daly 150 A BMS</text>
            <text x="371" y="85" class="t-sub">OV · UV · OC · OT · short</text>
            <line x1="120" y1="150" x2="120" y2="73" class="hv" />
            <line x1="120" y1="73" x2="274" y2="73" class="hv" marker-end="url(#ar-hv)" />

            <!-- BMS telemetry -->
            <rect x="700" y="40" width="220" height="66" rx="8" class="box box-soft" />
            <text x="810" y="66" class="t-title">Pi 5 → dashboard</text>
            <text x="810" y="85" class="t-sub">SoC, cell mV, temps, alarms</text>
            <line x1="464" y1="73" x2="696" y2="73" class="can" marker-end="url(#ar-sig)" />
            <text x="580" y="60" class="t-bus">CAN can1 250k</text>

            <!-- E-stop loop -->
            <rect x="278" y="150" width="186" height="112" rx="8" class="box box-warn" />
            <text x="371" y="176" class="t-title">E-stop safety loop</text>
            <text x="371" y="197" class="t-sub">physical button</text>
            <text x="371" y="215" class="t-sub">+ compute-driven relay</text>
            <text x="371" y="240" class="t-sub t-em">in series — both must close</text>
            <line x1="220" y1="206" x2="274" y2="206" class="hv" marker-end="url(#ar-hv)" />

            <!-- contactor -->
            <rect x="522" y="150" width="150" height="66" rx="8" class="box" />
            <text x="597" y="176" class="t-title">Main contactor</text>
            <text x="597" y="195" class="t-sub">cuts propulsion</text>
            <line x1="464" y1="183" x2="518" y2="183" class="hv" marker-end="url(#ar-hv)" />

            <!-- HV buck -->
            <rect x="522" y="260" width="150" height="60" rx="8" class="box" />
            <text x="597" y="284" class="t-title">HV DC-DC</text>
            <text x="597" y="302" class="t-sub">buck converter</text>
            <line x1="597" y1="216" x2="597" y2="256" class="hv" marker-end="url(#ar-hv)" />

            <!-- propulsion -->
            <rect x="700" y="240" width="220" height="100" rx="8" class="box" />
            <text x="810" y="266" class="t-title">Propulsion ≈5 kW</text>
            <text x="810" y="286" class="t-sub">VESC 6.7 ×2 → Flipsky 5085</text>
            <text x="810" y="304" class="t-sub">140 KV · 2500 W each</text>
            <text x="810" y="326" class="t-sub">30 A ESC → F2838 stern</text>
            <line x1="672" y1="290" x2="696" y2="290" class="hv" marker-end="url(#ar-hv)" />

            <!-- LV buck -->
            <rect x="522" y="374" width="150" height="60" rx="8" class="box" />
            <text x="597" y="398" class="t-title">LV DC-DC</text>
            <text x="597" y="416" class="t-sub">buck converter</text>
            <path d="M220 240 L246 240 L246 404 L518 404" class="lv" marker-end="url(#ar-lv)" />

            <!-- compute loads -->
            <rect x="700" y="360" width="220" height="106" rx="8" class="box" />
            <text x="810" y="386" class="t-title">Compute &amp; sensors</text>
            <text x="810" y="405" class="t-sub">Pi 5 · Jetson · Pixhawk 6C</text>
            <text x="810" y="423" class="t-sub">2× ESP32 · DM542C · 160 W driver</text>
            <text x="810" y="441" class="t-sub">lidars · sonar · GNSS · 5G router</text>
            <line x1="672" y1="404" x2="696" y2="404" class="lv" marker-end="url(#ar-lv)" />

            <!-- 9V backup — independent of the pack and of the contactor -->
            <rect x="20" y="404" width="200" height="66" rx="8" class="box box-warn" />
            <text x="120" y="430" class="t-title">9 V backup circuit</text>
            <text x="120" y="449" class="t-sub">independent of the main pack</text>

            <rect x="278" y="490" width="242" height="52" rx="8" class="box box-soft" />
            <text x="399" y="512" class="t-title">Locking lid</text>
            <text x="399" y="530" class="t-sub">clinch motors + Hall sensor</text>
            <path d="M120 470 L120 516 L274 516" class="lv" marker-end="url(#ar-lv)" />
            <text x="196" y="508" class="t-bus">opens it, system down</text>

            <!-- legend -->
            <g class="legend">
              <line x1="560" y1="500" x2="596" y2="500" class="hv" />
              <text x="604" y="504" class="t-legend">High-voltage / propulsion</text>
              <line x1="560" y1="524" x2="596" y2="524" class="lv" />
              <text x="604" y="528" class="t-legend">Low-voltage / compute</text>
              <line x1="792" y1="524" x2="828" y2="524" class="can" />
              <text x="836" y="528" class="t-legend">Telemetry</text>
            </g>
          </svg>
          <figcaption>
            The safety loop is the part worth reading twice: the E-stop button and a relay driven by
            the main computer sit <em>in series</em>, so either one opening cuts propulsion. The 9 V
            lid circuit is independent of everything else by design — it has to work when nothing
            else does.
          </figcaption>
        </figure>

        <p class="note">
          Converter part numbers, rail voltages and fuse ratings are not recorded in the software
          repos. Treat the two DC-DC blocks as placeholders until the hardware values are measured
          and written down.
        </p>
      </div>
    </section>

    <!-- ── GPIO ────────────────────────────────────────────────────────── -->
    <section class="section">
      <div class="container">
        <span class="eyebrow">GPIO</span>
        <h2 class="section-title">Two ESP32s, one pinout, different meanings</h2>
        <p class="section-lead">
          The active stabilisation runs on two separate ESP32 boards. Both take servo PWM from the
          Pixhawk and both use the same eight GPIO pins — but those pins drive completely different
          hardware on each board. Getting the two mixed up is the easiest way to damage something.
        </p>

        <figure class="diagram" data-reveal>
          <svg
            viewBox="0 0 940 400"
            role="img"
            aria-label="Signal chains for the two ESP32 boards. Left chain, roll trim: the Pixhawk sends PWM on two channels into the translator ESP32 on GPIO 34 and 35, which outputs on GPIO 25, 26, 27 and 12, 14, 13 to a 160 watt H-bridge driver, which drives the left and right ama linear actuators. Right chain, pitch trim: the Pixhawk sends PWM into the slider ESP32 on GPIO 34 while the Raspberry Pi supplies a homing trigger on GPIO 35, and the board outputs step, direction and enable on GPIO 25, 26, 27 to a DM542C stepper driver, which drives the Nema 23 that slides the battery pack. Three endstops return on GPIO 12, 14 and 13."
          >
            <defs>
              <marker id="ar-chain" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0,1 L9,5 L0,9 z" class="fill-wire" />
              </marker>
            </defs>

            <text x="20" y="24" class="zone">ROLL TRIM — the amas</text>
            <text x="500" y="24" class="zone">PITCH TRIM — the battery rail</text>
            <line x1="470" y1="40" x2="470" y2="376" class="divider" />

            <!-- ── left chain ── -->
            <rect x="20" y="52" width="180" height="48" rx="8" class="box box-soft" />
            <text x="110" y="72" class="t-title">Pixhawk 6C</text>
            <text x="110" y="90" class="t-sub">servo out 1 &amp; 2</text>

            <rect x="20" y="150" width="180" height="72" rx="8" class="box box-accent" />
            <text x="110" y="176" class="t-title">Translator ESP32</text>
            <text x="110" y="195" class="t-sub">deadband 25 µs</text>
            <text x="110" y="212" class="t-sub t-em">failsafe 200 ms</text>

            <rect x="20" y="264" width="180" height="52" rx="8" class="box" />
            <text x="110" y="286" class="t-title">160 W H-bridge</text>
            <text x="110" y="304" class="t-sub">IN1/IN2/ENA · IN3/IN4/ENB</text>

            <rect x="248" y="264" width="196" height="52" rx="8" class="box box-soft" />
            <text x="346" y="286" class="t-title">Ama linear actuators</text>
            <text x="346" y="304" class="t-sub">left + right — righting moment</text>

            <line x1="110" y1="100" x2="110" y2="146" class="pwm" marker-end="url(#ar-chain)" />
            <text x="118" y="127" class="t-bus a-start">PWM → GPIO 34, 35</text>
            <line x1="110" y1="222" x2="110" y2="260" class="wire" marker-end="url(#ar-chain)" />
            <text x="118" y="247" class="t-bus a-start">GPIO 25,26,27 · 12,14,13</text>
            <line x1="200" y1="290" x2="244" y2="290" class="wire" marker-end="url(#ar-chain)" />

            <!-- ── right chain ── -->
            <rect x="500" y="52" width="180" height="48" rx="8" class="box box-soft" />
            <text x="590" y="72" class="t-title">Pixhawk 6C</text>
            <text x="590" y="90" class="t-sub">servo out</text>

            <rect x="712" y="52" width="180" height="48" rx="8" class="box box-soft" />
            <text x="802" y="72" class="t-title">Raspberry Pi 5</text>
            <text x="802" y="90" class="t-sub">homing trigger 3.3 V</text>

            <rect x="500" y="150" width="180" height="72" rx="8" class="box box-accent" />
            <text x="590" y="176" class="t-title">Slider ESP32</text>
            <text x="590" y="195" class="t-sub">deadband 30 µs</text>
            <text x="590" y="212" class="t-sub t-em">failsafe 300 ms</text>

            <rect x="500" y="264" width="180" height="52" rx="8" class="box" />
            <text x="590" y="286" class="t-title">DM542C driver</text>
            <text x="590" y="304" class="t-sub">PUL+ · DIR+ · ENA+</text>

            <rect x="712" y="264" width="196" height="52" rx="8" class="box box-soft" />
            <text x="810" y="286" class="t-title">Nema 23 → battery rail</text>
            <text x="810" y="304" class="t-sub">3200 back · 5000 front (steps)</text>

            <line x1="590" y1="100" x2="590" y2="146" class="pwm" marker-end="url(#ar-chain)" />
            <text x="598" y="127" class="t-bus a-start">PWM → GPIO 34</text>
